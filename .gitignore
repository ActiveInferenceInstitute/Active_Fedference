# Generated outputs are regeneratable; and we want to commit them.
# output/
# Renderer logs are local validation evidence. They can contain wall-clock and
# machine-path details, so retain them in external verification receipts rather
# than in the public source history.
output/**/*.aux
output/**/*.bbl
output/**/*.blg
output/**/*.lof
output/**/*.log
output/**/*.lot
output/**/*.nav
output/**/*.out
output/**/*.snm
output/**/*.toc
output/**/*.vrb

# Local agent/editor settings (machine-specific; surfaced after this repo was
# detached from the projects submodule, which had been masking it).
.claude/
.playwright-cli/

# Local credential files. Release tooling reports only the selected variable
# name and supports an absolute caller-managed path outside the checkout.
.env
.env.*
*.env
!*.env.example

# Test artifacts
.coverage
.coverage.*
.tmp/
.tools/
# Regeneratable coverage export; a committed copy drifts stale (was 14.5% vs the
# real ~95%). Kept out of git so the enforced --cov-fail-under gate is the sole
# source of truth for coverage.
coverage_project.json
.pytest_cache/
__pycache__/
*.pyc
.benchmarks/

# Egg-info from local installs (any location — guards against renamed-fork drift).
**/*.egg-info/

# Project-local virtualenvs (root .venv is shared)
.venv/

# macOS
.DS_Store
**/.DS_Store
