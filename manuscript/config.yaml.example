# Active Fedference — Project Configuration Template
# Copy this file to config.yaml and customize for your project.
# This file is the meta-artifact linking manuscript prose to the execution
# layer. It is loaded by `yaml.safe_load` inside the rendering pipeline and
# by the experiment harness for the `experiment:` block.
#
# Every numeric value in the manuscript prose is a {{TOKEN}} hydrated from
# analysis outputs — never hand-typed. The experiment keys below are only the
# keys actually consumed by `src/experiment_config.py::load_experiment_config`
# (ExperimentConfig); every other per-study parameter (acuity, language-
# acquisition steps, emergence scales, contamination internals) lives as a
# code default in `src/fedference/experiments/` and is surfaced as a
# manuscript token directly from those constants.

paper:
  # Follow the RASP standard: titles must be objective and descriptive
  title: "Your Active Fedference Title"
  subtitle: "Optional Subtitle Describing the Contribution"
  cover:
    image: "cover_image.png"
    alt: "Graphical abstract description"
    description: "Regenerated by src/figures/graphical_abstract.py"
  version: "1.0"
  date: ""  # Auto-generated at render time if empty

authors:
  - name: "Your Name"
    orcid: "0000-0000-0000-0000"  # Get from https://orcid.org/
    email: "your.email@institution.edu"
    affiliation: "Your Institution"
    corresponding: true

# Optional: Multiple authors
#  - name: "Co-Author Name"
#    orcid: "0000-0000-0000-0000"
#    email: "coauthor@institution.edu"
#    affiliation: "Co-Author Institution"
#    corresponding: false

publication:
  doi: "(forthcoming)"  # Assigned at first deposit
  github_repository: "https://github.com/your_org/active_fedference"
  journal: ""
  year: "2026"
  # Required by src/publication/metadata.py::build_metadata() — that function
  # does direct dict indexing (pub["software_name"], pub["abstract"],
  # pub["description"], pub["date_created"], pub["date_released"], no
  # fallback) to emit CITATION.cff, .zenodo.json, and codemeta.json. Fill
  # these in before running `python scripts/emit_metadata.py --write`, or
  # that command raises a KeyError.
  software_name: "Your Project Name"
  date_created: "YYYY-MM-DD"
  # Keep null until the external release authority approves publication.
  date_released: null # Replace with "YYYY-MM-DD" at release
  abstract: >-
    One-paragraph abstract describing the software for CITATION.cff and
    .zenodo.json.
  description: >-
    Short description of the source code and reproducible artifacts for
    codemeta.json and .zenodo.json.
  # Optional (build_metadata() reads these with .get(), so they are not
  # strictly required):
  github_description: >-
    One-line GitHub repository description.
  related_identifiers:
    - relation: "cites"
      identifier: "https://doi.org/10.0000/example"

keywords:
  - "active inference"
  - "federated learning"
  - "generalised variational inference"
  - "belief sharing"
  - "robustness"
  - "FedGVI"

metadata:
  license: "MIT"  # or Apache-2.0, etc.
  language: "en"

# Render format toggles.
render:
  formats:
    pdf: true
    html: true
    slides: true
    docx: false
    epub: false

# Combined-PDF page flow only. The default true inserts a page break between
# source files; false lets modular fragments flow continuously. Use an explicit
# raw-LaTeX \newpage in source when a hard boundary is required.
rendering:
  section_breaks: true

# LLM review / translation toggles (optional; require Ollama).
llm:
  reviews:
    enabled: false
    types:
      - methodology_review
  translations:
    enabled: false
    languages: []

# Real-computation tolerance: any failure blocks manuscript rendering.
testing:
  max_test_failures: 0
  max_infra_test_failures: 0
  max_project_test_failures: 0

# Experiment parameters — consumed by `src/experiment_config.py`
# (load_experiment_config) and, through it, the experiment harness and the
# manuscript-variable generator. Only keys that load_experiment_config actually
# reads live here.
experiment:
  # Publication budgets are the default. Temporary test projects may declare
  # `analysis_profile: smoke` for repeated real, lower-budget checks.
  analysis_profile: publication
  # Independent-seed budget for the across-seed studies (belief sharing) and the
  # paired-trial count of the robustness verdict. Runs derive their deterministic
  # seed list as range(n_seeds) (ExperimentConfig.seeds); there is no single
  # global seed knob.
  n_seeds: 480
  # Independent seed budget for the structural-extension and cross-study tier.
  replicate_seeds: 128

  # Study 4 — contaminated-sentinel robustness sweep (the FedGVI contribution).
  # `divergences` lists the FedGVI client-divergence labels; KLD is the non-robust
  # Friston / standard-Bayes baseline (robustness 0), the rest are robust members.
  # `n_agents` here is the executed colony size for ALL studies (the sweep block
  # takes precedence in load_experiment_config).
  robustness_sweep:
    rates: [0.0, 0.225, 0.45, 0.675, 0.9]
    divergences: ["KLD", "RKL", "AR", "beta", "rcce"]
    n_agents: 7
    n_trials: 960

  # Matched trials per rate in the cross-study overview.
  cross_study_n_trials: 40
  conditional_world_n_seeds: 64
  conditional_world_n_trials: 24
  # The review grid must meet this maximum MCSE across every signed
  # method-by-rate contrast; the producer fails closed when it does not.
  review_grid_n_seeds: 160
  review_grid_n_trials: 24
  review_grid_rates: [0.0, 0.2, 0.4, 0.5, 0.6, 0.7, 0.8, 0.9]
  review_grid_target_max_mcse: 0.01

  # Explicit publication budgets for source-bound diagnostic lanes. These
  # values are consumed directly by ExperimentConfig rather than hidden in
  # workflow defaults.
  gallery_n_seeds: 64
  gallery_n_trials: 24
  onset_n_seeds: 64
  onset_n_trials: 24
  bnn_n_seeds: 64
  bnn_n_per: 200

  # Optional executed PyTorch complement; these knobs are read by
  # analysis.workflow, not by ExperimentConfig. Keep this profile explicit so
  # smoke fixtures can reduce compute without changing the publication lane.
  bnn_torch:
    n_clients: 5
    n_per: 80
    hidden_dim: 16
    n_steps: 200
    robustness: 0.5
    beta: 0.5
    contamination_levels: [0.0, 0.2, 0.4]

  # Paired-statistics / multiple-testing deflation (Algorithm Gate I). The
  # primary sweep and the all-method review grid consume these registered
  # levels; their reports echo the executed values rather than hard-coding a
  # second statistical design.
  statistics:
    test: "wilcoxon"        # matched-pairs signed-rank (statistics.paired_test)
    fdr_alpha: 0.05         # Benjamini-Hochberg family-wise FDR (statistics.bh_fdr)
    # Power analysis for the headline robust-vs-naive Wilcoxon (statistics.power_analysis):
    # the alpha and one-sided alternative the achieved-power / prospective-n tokens use.
    power_alpha: 0.05
    power_alternative: "greater"   # robust accuracy > naive (directional)
    target_power: 0.80             # prospective sample-size justification target

# Stage 02 analysis-script allowlist.
analysis:
  scripts:
    - 01_run_invariants.py
    - 02_run_analysis.py
    - z_generate_manuscript_variables.py
